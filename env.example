APP_NAME="Reggit"
NATIVE_APP_USER_AGENT_TOKEN=Reggit
NATIVE_APP_URL_SCHEME=reggit
NATIVE_APP_ORDER_TYPE_MOBILE_LABEL=Reggit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://reggit.test
APP_API_BASE=/api
# デモ用アカウント（demo_sys / demo_proj / demo_store）を作成する場合は true
DEMO_SEED=true
DEMO_SYSTEM_LOGIN_ID=demo_sys
# パスワードに # を含む場合は必ず " " で囲む（# は .env でコメント扱いになるため）
DEMO_SYSTEM_PASSWORD="DemoSys#2026"
DEMO_SYSTEM_EMAIL=demo_sys@example.com
DEMO_SYSTEM_NAME=デモシステム管理者
DEMO_PROJECT_LOGIN_ID=demo_proj
DEMO_PROJECT_PASSWORD="DemoProj#2026"
DEMO_PROJECT_EMAIL=demo_proj@example.com
DEMO_PROJECT_NAME=デモプロジェクト管理者
DEMO_STORE_LOGIN_ID=demo_store
DEMO_STORE_PASSWORD="DemoStore#2026"
DEMO_STORE_EMAIL=demo_store@example.com
DEMO_STORE_NAME=デモ店舗管理者

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reggit
DB_USERNAME=reggit_user
DB_PASSWORD=password

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_URL=
# LIFF 保存時に Module mode を自動有効化（共有・更新メニュー非表示）。false で無効化
LINE_LIFF_AUTO_MODULE_MODE=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PUSH_FCM_ENABLED=false
PUSH_FCM_SERVER_KEY=
PUSH_FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send

# OneSignal（iOS/Android アプリ用プッシュ通知）
# - PUSH_ONESIGNAL_APP_ID: モバイルアプリ（iOS Info.plist の OneSignalAppId）と完全に同一にすること
# - PUSH_ONESIGNAL_API_KEY: OneSignal Dashboard > Settings > Keys & IDs > REST API Key（Key の値のみ、プレフィックス "Key " は不要）
# - 届かない場合: php artisan push:onesignal-test --force --segment でセグメント送信を試し、配信先件数で切り分け
PUSH_ONESIGNAL_ENABLED=true
PUSH_ONESIGNAL_APP_ID=56c917d6-5297-415c-b4c4-67640702e10b
PUSH_ONESIGNAL_API_KEY=
PUSH_ONESIGNAL_API_URL=https://api.onesignal.com/notifications

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# 開発は sync で可。本番は database（+ queue:work）または sqs（+ ワーカー）
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480

# クライアントデバッグ API（/api/client-debug）。本番は false。APP_DEBUG=true 時も有効
CLIENT_DEBUG_ENABLED=false

# Sentry（未設定なら no-op）
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

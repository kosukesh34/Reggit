APP_NAME="Reggit"
NATIVE_APP_USER_AGENT_TOKEN=Reggit
NATIVE_APP_URL_SCHEME=reggit
NATIVE_APP_ORDER_TYPE_MOBILE_LABEL=Reggit
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_API_BASE=/api

LOG_CHANNEL=stack
LOG_LEVEL=debug

# テスト専用 DB。開発 DB (reggit) を RefreshDatabase で破壊しないために必須。
# 初回: cp env.testing.example .env.testing && make test-db
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reggit_test
DB_USERNAME=reggit_user
DB_PASSWORD=password

BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

DEMO_SEED=true
DEMO_SYSTEM_LOGIN_ID=demo_sys
DEMO_SYSTEM_PASSWORD="DemoSys#2026"
DEMO_SYSTEM_EMAIL=demo_sys@example.com
DEMO_SYSTEM_NAME=デモシステム管理者

SMAREGI_CLIENT_ID=test_client_id
SMAREGI_CLIENT_SECRET=test_client_secret
SMAREGI_ID_BASE_URL=https://id.smaregi.dev
SMAREGI_API_BASE_URL=https://api.smaregi.dev
SMAREGI_CONTRACT_ID=test_contract

WALLET_PASS_ENABLED=false
GOOGLE_WALLET_ENABLED=false

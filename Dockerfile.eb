# Elastic Beanstalk 用: Nginx + PHP-FPM を1コンテナで動かし、PORT 8080 で待ち受ける
FROM php:8.4-fpm

# Nginx と PHP 拡張の依存
RUN apt-get update && apt-get install -y \
    nginx \
    git \
    curl \
    libcurl4-openssl-dev \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# アプリケーションをコピー（.dockerignore で不要ファイルを除外）
COPY . .

# 必要なディレクトリを確保
RUN mkdir -p storage/framework/{sessions,views,cache} storage/logs bootstrap/cache

# 本番用に依存関係のみインストール（.env は EB の環境変数で渡す）
RUN composer install --no-dev --optimize-autoloader --no-interaction

# PHP-FPM: 同時リクエスト対応（pm.max_children 枯渇で 4xx / ヘルスチェック失敗を防ぐ）
# 50 children で約 1.5–2.5GB RAM 想定。t3.micro の場合はインスタンスのスケールアップを検討
RUN set -eux; \
    sed -i 's/^pm = .*/pm = dynamic/' /usr/local/etc/php-fpm.d/www.conf; \
    sed -i 's/^pm\.max_children = .*/pm.max_children = 50/' /usr/local/etc/php-fpm.d/www.conf; \
    sed -i 's/^pm\.start_servers = .*/pm.start_servers = 10/' /usr/local/etc/php-fpm.d/www.conf; \
    sed -i 's/^pm\.min_spare_servers = .*/pm.min_spare_servers = 10/' /usr/local/etc/php-fpm.d/www.conf; \
    sed -i 's/^pm\.max_spare_servers = .*/pm.max_spare_servers = 20/' /usr/local/etc/php-fpm.d/www.conf

# Nginx 設定（EB では 8080 をリッスン）
COPY docker/nginx/eb-default.conf /etc/nginx/sites-available/default
RUN echo "daemon off;" >> /etc/nginx/nginx.conf

# 起動スクリプト: storage 配下を確保・storage:link のあと php-fpm と nginx を起動
RUN echo '#!/bin/sh\n\
mkdir -p /var/www/html/storage/framework/sessions /var/www/html/storage/framework/views /var/www/html/storage/framework/cache /var/www/html/storage/logs /var/www/html/storage/app/public /var/www/html/bootstrap/cache\n\
chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache\n\
chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache\n\
php /var/www/html/artisan storage:link 2>/dev/null || true\n\
php-fpm -D\n\
exec nginx' > /start.sh && chmod +x /start.sh

# 書き込み可能なディレクトリ
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 8080
CMD ["/start.sh"]

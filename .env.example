APP_NAME="Mobile Order"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mobile_order
# Docker で Access denied が出る場合は root/root にするか docs/DOCKER_DB_FIX.md を参照
DB_USERNAME=mobile_order_user
DB_PASSWORD=password

# LINE ミニアプリ（LIFF）
# LIFF URL が https://miniapp.line.me/2008962885-44xGRSQL の場合:
#   LINE_LIFF_ID=2008962885-44xGRSQL  （liff.init に渡すID）
#   LINE_LIFF_URL=https://miniapp.line.me/2008962885-44xGRSQL  （Webhook の案内リンク用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_LIFF_URL=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# スマレジ・プラットフォームAPI 連携
SMAREGI_CLIENT_ID=
SMAREGI_CLIENT_SECRET=
SMAREGI_ID_BASE_URL=https://id.smaregi.dev
SMAREGI_API_BASE_URL=https://api.smaregi.dev
SMAREGI_SCOPE="pos.stores:read pos.stores:write pos.products:read pos.products:write pos.transactions:read pos.transactions:write pos.customers:read pos.customers:write pos.stock:read pos.stock:write pos.staffs:read pos.suppliers:read pos.terminals:notify"
SMAREGI_WEBHOOK_SECRET=
SMAREGI_WEBHOOK_SECRET_HEADER=X-Smaregi-Webhook-Secret

# Apple Wallet（会員証を Wallet に追加）
WALLET_PASS_ENABLED=false
WALLET_PASS_TEAM_ID=
WALLET_PASS_TYPE_ID=
WALLET_PASS_CERT_PATH=storage/app/wallet_pass/certificates/pass.cer
WALLET_PASS_KEY_PATH=storage/app/wallet_pass/certificates/iOS-Passkey-Key.key
WALLET_PASS_WWDR_PATH=storage/app/wallet_pass/certificates/AppleWWDRCAG3.cer
WALLET_PASS_ASSETS_PATH=storage/app/wallet_pass/assets

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


APP_NAME="Reggit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# 管理画面ログイン（システム管理者の「いつものログインID」）
# AdminUserSeeder で login_id に ADMIN_LOGIN_ID（未設定時は ADMIN_EMAIL）が使われます
# パスワードに # を含む場合は "で囲む（例: "DemoSys#2026"）
ADMIN_LOGIN_ID=
ADMIN_EMAIL=reserve
ADMIN_PASSWORD=reserve
ADMIN_NAME=システムアドミン

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reggit
# Docker で Access denied が出る場合は root/root にするか docs/DOCKER_DB_FIX.md を参照
DB_USERNAME=reggit_user
DB_PASSWORD=password

# LINE ミニアプリ（LIFF）
# LINE_LIFF_ID: LINE Developer Console で LIFF アプリ作成後に取得したIDを設定。未設定だとLINE内で「LIFF ID が未設定です」と表示。全プロジェクトのデフォルト（管理画面でプロジェクト別に上書き可能）
# LINE_LIFF_URL: 未設定時は APP_URL/liff/default を使用。同一URLで全プロジェクトでも可。プロジェクトID（パス）は管理画面で変更可能
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_LIFF_URL=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# スマレジ・プラットフォームAPI 連携（スマレジ・デベロッパーズの「環境設定」で発行した値をここに記載。管理画面では設定できません）
SMAREGI_CLIENT_ID=
SMAREGI_CLIENT_SECRET=
# 契約ID（未設定時は config/smaregi.php のデフォルト）。ローカルとAWSで別契約の場合は .env と EB でそれぞれ設定
# SMAREGI_CONTRACT_ID=
SMAREGI_ID_BASE_URL=https://id.smaregi.dev
SMAREGI_API_BASE_URL=https://api.smaregi.dev
SMAREGI_SCOPE="pos.stores:read pos.stores:write pos.products:read pos.products:write pos.transactions:read pos.transactions:write pos.customers:read pos.customers:write pos.stock:read pos.stock:write pos.staffs:read pos.suppliers:read pos.terminals:notify"
SMAREGI_WEBHOOK_SECRET=
SMAREGI_WEBHOOK_SECRET_HEADER=x-sdsch-idnect

# Apple Wallet（会員証を Wallet に追加）
WALLET_PASS_ENABLED=false
WALLET_PASS_TEAM_ID=
WALLET_PASS_TYPE_ID=
WALLET_PASS_CERT_PATH=storage/app/wallet_pass/certificates/pass.cer
WALLET_PASS_KEY_PATH=storage/app/wallet_pass/certificates/iOS-Passkey-Key.key
WALLET_PASS_WWDR_PATH=storage/app/wallet_pass/certificates/AppleWWDRCAG3.cer
WALLET_PASS_ASSETS_PATH=storage/app/wallet_pass/assets

# Google Wallet（会員証を Google Wallet に追加・Android 等）
# Issuer ID は Pay & Wallet Console で確認（例: 3388000000023085556）
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CREDENTIALS_PATH=storage/app/google_wallet/credentials.json
# ボタン表示を許可するオリジン（カンマ区切り）。例: https://localhost:8080
GOOGLE_WALLET_ORIGINS=https://example.com,https://liff.line.me
# クラス識別子。変えると「新しいカード」として追加される（例: membership_v3 = 日本語・バーコード）
GOOGLE_WALLET_CLASS_SUFFIX=membership_v3
# 検証用: 会員未登録でも URL を発行する（本番では false または未設定）
# GOOGLE_WALLET_ALLOW_DEMO_USER=false
# カード背景色（#rrggbb）。未設定時は画像の主色が使われる
# GOOGLE_WALLET_HEX_BACKGROUND_COLOR=

# Push通知（FCM HTTP v1）
# ネイティブアプリの FCM registration token を user_devices.push_token に保存して配信する。
PUSH_FCM_ENABLED=false
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CREDENTIALS=storage/app/firebase/reggit-dbb5a-adminsdk.json

# OneSignal（レガシー。FCM 有効時は使わない）
PUSH_ONESIGNAL_ENABLED=false
PUSH_ONESIGNAL_APP_ID=
PUSH_ONESIGNAL_API_KEY=
PUSH_ONESIGNAL_API_URL=https://api.onesignal.com/notifications

BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb
REVERB_APP_ID=1001
REVERB_APP_KEY=reggit-reverb-key
REVERB_APP_SECRET=reggit-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 日本郵便 郵便番号・デジタルアドレスAPI（住所自動入力）
# スタブ（テスト用）: 一部の郵便番号のみ。本番は biz.da.pf.japanpost.jp + 本番用ID/シークレット（要・Biz登録）
JAPANPOST_API_HOST=stub-qz73x.da.pf.japanpost.jp
JAPANPOST_CLIENT_ID=Biz_DaPfJapanpost_MockAPI_j3QKS
JAPANPOST_CLIENT_SECRET=uXuN0ejHG7nAn89AfAwa

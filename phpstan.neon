includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
    level: 0
    tmpDir: storage/framework/cache/phpstan
    # ローカル CI のコンテナ（メモリ1GB、うちソースのコピー約110MB）に収める。
    # 作業プロセスは1つで約420MB 使うため、2つだと上限を超えて強制終了される（単独でも約20秒で終わる）
    parallel:
        maximumNumberOfProcesses: 1

{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint resources/js --max-warnings=0",
    "test:unit:frontend": "node --experimental-strip-types --test resources/js/frontend/member/*.test.mjs resources/js/frontend/navigation/*.test.mjs resources/js/payment/*.test.mjs",
    "test:e2e": "playwright test --config=e2e/web/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/web/playwright.config.ts --ui"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "laravel-echo": "^2.5.0",
    "lucide-react": "^1.52.0",
    "pusher-js": "^8.6.0",
    "qrcode": "^1.5.4",
    "qrcodejs": "^1.0.0",
    "qrcodejs2": "^0.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "laravel-vite-plugin": "^3.2.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}

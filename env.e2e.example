# Web E2E 専用の設定（scripts/e2e-web.sh が e2e コンテナの .env として読み込む）。
# 開発用の .env を読まないため、メール・LINE・スマレジ・Stripe 等の実接続は行わない。
# DB は使い捨ての reggit_e2e、ログは標準エラー、storage はコンテナ内の一時領域に書き、終了時にすべて消える。
APP_NAME="Reggit"
NATIVE_APP_USER_AGENT_TOKEN=Reggit
NATIVE_APP_URL_SCHEME=reggit
NATIVE_APP_ORDER_TYPE_MOBILE_LABEL=Reggit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_API_BASE=/api

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reggit_e2e
DB_USERNAME=reggit_user
DB_PASSWORD=password

BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

DEMO_SEED=true

# 実 LIFF 画面を表示するためのダミー ID（E2E は LIFF SDK を読み込まない）
LINE_LIFF_ID=0000000000-e2e

WALLET_PASS_ENABLED=false
GOOGLE_WALLET_ENABLED=false
PUSH_FCM_ENABLED=false
LINE_VERIFY_LIFF_ID_TOKEN=false

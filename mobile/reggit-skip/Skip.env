// The configuration file for your Skip App (https://skip.dev).
// Properties specified here are shared between
// Darwin/Reggit.xcconfig and Android/settings.gradle.kts
// and will be included in the app's metadata files
// Info.plist and AndroidManifest.xml

// PRODUCT_NAME is the default title of the app, which must match the app's Swift module name
PRODUCT_NAME = Reggit

// Native app identity (must match Laravel config/native_app.php)
NATIVE_APP_USER_AGENT_TOKEN = Reggit
NATIVE_APP_URL_SCHEME = reggit

// PRODUCT_BUNDLE_IDENTIFIER is the unique id for both the iOS and Android app
PRODUCT_BUNDLE_IDENTIFIER = com.reggit.default

// The semantic version of the app
MARKETING_VERSION = 0.0.1

// The build number specifying the internal app version
CURRENT_PROJECT_VERSION = 1

// The package name for the Android entry point, referenced by the AndroidManifest.xml
ANDROID_PACKAGE_NAME = reggit.app

// LIFF/WebView のベースURL。本番は HTTPS の独自ドメイン。
LIFF_BASE_URL = https://reggit.shop
LIFF_BASE_URL_IOS = https://reggit.shop
LIFF_BASE_URL_ANDROID = https://reggit.shop

// 表示する LIFF の project_key。個別指定があればそちらを優先。
LIFF_PROJECT_KEY = default
// iOS / Android で別プロジェクトを表示したい場合は以下を設定。
// LIFF_PROJECT_KEY_IOS = default
// LIFF_PROJECT_KEY_ANDROID = default

// 起動時に固定表示するタブ。ネイティブ/LIFF のタブ遷移はロックされる。
// 値: home, products, orders, stamps, coupons, queue, member, reservations, gallery
LIFF_FIXED_TAB = products
// iOS / Android で別タブにしたい場合は以下を設定。
// LIFF_FIXED_TAB_IOS = products
// LIFF_FIXED_TAB_ANDROID = products

// If your Android appId is different from the iOS Bundle Identifer, specify it here
// google-services.json の package_name と一致させる（OneSignal/FCM 用）
ANDROID_APPLICATION_ID = com.reggit.default

// OneSignal App ID (iOS/Android 共通). Dashboard > Settings > Keys & IDs
ONE_SIGNAL_APP_ID = 56c917d6-5297-415c-b4c4-67640702e10b

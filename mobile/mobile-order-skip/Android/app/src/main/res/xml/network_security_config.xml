<?xml version="1.0" encoding="utf-8"?>
<!-- WebView が HTTPS（ngrok 含む）を読み込めるようにする。本番では必要に応じて制限すること。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

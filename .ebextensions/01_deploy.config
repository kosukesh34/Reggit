# Elastic Beanstalk デプロイ時の Composer / Artisan 実行
# 本番で使う場合のみ有効にし、必要に応じてコメントアウトや順序を調整してください
container_commands:
  01_composer_install:
    command: "composer install --no-dev --optimize-autoloader"
    leader_only: true
  02_artisan_migrate:
    command: "php artisan migrate --force"
    leader_only: true
  03_artisan_storage_link:
    command: "php artisan storage:link || true"
    leader_only: true
  04_artisan_optimize:
    command: "php artisan config:cache && php artisan route:cache && php artisan view:cache"
    leader_only: true
